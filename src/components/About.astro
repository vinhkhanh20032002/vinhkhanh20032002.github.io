---
import site from '../data/site.json';
---

<section id="about" class="section alt">
  <div class="container">
    <div class="about">
      <div class="left">
        <div class="eyebrow">About</div>
        <h2 class="h2">{site.aboutTitle}</h2>
      </div>
      <div class="right">
        {site.about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
